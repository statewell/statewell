    "test": "bun test --timeout 15000"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "typescript": "^5.9.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "^4.0.0"
  },
  "packageManager": "bun@1.4.2"
}
